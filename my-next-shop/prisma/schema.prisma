datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id        Int      @id @default(autoincrement())
  adminId   String   @unique @map("admin_id")
  password  String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model User {
  id                  Int      @id @default(autoincrement())
  
  // 👤 1. 기본 로그인 정보
  loginId             String   @unique @map("login_id")
  password            String
  name                String
  nickname            String?
  // 🌟 카카오·네이버 등 SNS 로그인에서 받아온 프로필 이미지 URL (직접 업로드는 아직 없음)
  profileImage        String?  @map("profile_image") @db.Text
  email               String?  @unique
  phone               String?
  
  // ✈️ 2. 구매대행 필수 배송 정보
  personalCustomsCode String?  @map("personal_customs_code")
  zipCode             String?  @map("zip_code")
  address             String?
  detailAddress       String?  @map("detail_address")
  
  // 🌟 기본 배송지 ID
  defaultAddressId    Int?     @map("default_address_id")
  
  // 💰 3. 비즈니스 로직 (결제/등급)
  cyberMoney          Int      @default(0) @map("cyber_money")
  membershipGrade     Int      @default(0) @map("membership_grade")           // membership_grades.id 참조 (0 = NEW)
  grade               MembershipGrade @relation(fields: [membershipGrade], references: [id])
  addressId           String?   @map("address_id") @db.Text
  
  // 🗓️ 4. 가입 및 수정 일자
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  orders              Order[]
  addresses           Address[]

  moneyRequests MoneyRequest[]

  // 🆕 머니 로그와의 1:N 관계 추가
  moneyLogs MoneyLog[]

  @@map("users")
}

model Address {
  id                  Int      @id @default(autoincrement())
  userId              Int      @map("user_id")
  user                User     @relation(fields: [userId], references: [id])

  recipientName       String   @map("recipient_name")
  recipientEnglishName String? @map("recipient_english_name")
  phone               String   @map("phone")
  zipCode             String   @map("zip_code")
  address             String   @map("address")
  detailAddress       String   @map("detail_address")
  personalCustomsCode String?  @map("personal_customs_code")
  isDefault           Boolean  @default(false) @map("is_default")
  
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("addresses")
}

enum OrderType {
  DELIVERY // 배송대행
  PURCHASE // 구매대행
}

// 2. 주문 상태 Enum (신규 추가)
enum OrderStatus {
  ALL            // 전체 내역
  BID_PENDING    // 경매 요청
  BIDDING        // 경매 낙찰 실패
  BID_SUCCESS    // 경매 낙찰 성공
  CART           // 장바구니
  FAILED         // 낙찰/구매실패
  PAID           // 상품 결제 완료
  ARRIVED        // 입고완료
  PREPARING      // 배송 준비중
  PAYMENT_REQ    // 배송비 요청
  PAYMENT_DONE   // 배송비 결제 완료
  SHIPPING       // 국제배송
}

// 3. 배송 상태 Enum (신규 추가)
enum DeliveryStatus {
  PREPARING      // 배송전
  SHIPPED        // 배송시작 (국제배송 시작)
  CUSTOMS        // 국내통관중
  LOCAL_DELIVERY // 국내배송중
  COMPLETED      // 배송완료
}

// 🌟 경매 상태값을 관리하는 Enum
enum BidStatus {
  PENDING               // 입찰 대기중
  COMPLETED             // 입찰 완료
  ADDITIONAL            // 추가 입찰 완료
}

model Order {
  // 1. 시스템 및 관계 필드
  id                  Int            @id @default(autoincrement())
  userId              Int            @map("user_id")
  user                User           @relation(fields: [userId], references: [id])

  // 2. 서비스 구분
  type                OrderType      @default(PURCHASE) @map("order_type")

  // 3. 주문 식별 및 배송 정보
  bundleId            String?        @map("bundle_id")
  orderId             String         @unique @map("order_id")
  productId           String?        @map("product_id")
  trackingNo          String?        @map("tracking_no")

  // 4. 상품 상세 정보
  productImageUrl     String?        @db.Text @map("product_image_url")
  productPrice        Int            @map("product_price") // 현재 최고가 또는 낙찰가로 활용
  productCount        Int?           @default(1)
  productName         String         @map("product_name")
  productUrl          String?        @db.Text @map("product_url")
  productOption       String?        @map("product_option")
  productRequest      String?        @map("productRequest")

  // 5. 타임스탬프 (경매 관련 추가)
  registeredAt        DateTime       @default(now()) @map("registered_at")
  receivedAt          DateTime?      @map("received_at")
  shippedAt           DateTime?      @map("shipped_at")
  auctionEndDate      DateTime?      @map("auction_end_date")       // 🌟 1. 경매 종료 시간

  // 6. 상태 관리
  serviceRequest      String?        @map("service_request")
  status              OrderStatus    @default(CART)
  deliveryStatus      DeliveryStatus @default(PREPARING) @map("delivery_status")

  // 7. 비용 및 결제 관련 (경매 정보 추가)
  purchaseFee         Int            @default(0) @map("purchase_fee")
  domesticShippingFee Int            @default(0) @map("domestic_shipping_fee")
  addressId           Int?           @map("address_id")
  secondPaymentAmount Int?           @map("second_payment_amount")
  
  myBidPrice          Int?           @default(0) @map("my_bid_price") // 🌟 2. 내 입찰 금액 (현지 통화)
  depositAmount       Int?           @default(0) @map("deposit_amount") // 🌟 3. 보증금 (원화 또는 현지 통화)
  
  // 🌟 [수정됨] 타입을 String? 에서 BidStatus? 로 변경하고 기본값을 PENDING으로 설정
  bidStatus           BidStatus?     @default(PENDING) @map("bid_status") 

  @@map("orders")
}

enum FeeType {
  TRANSFER // 송금 수수료
  AGENCY   // 대행 수수료
}

model FeeConfiguration {
  id                  Int      @id @default(autoincrement())                  // 데이터베이스 내부 관리용 고유 ID (자동 증가)
  name                String                                                  // 수수료 명칭 (예: "기본 송금 수수료", "메르카리 대행 수수료")
  feeType             FeeType  @map("fee_type")                               // 수수료 타입 구분 (예: TRANSFER, AGENCY)
  amount              Int      @default(0)                                    // 수수료 금액 (단위: 엔 ¥)
  description         String?  @db.Text                                       // 관리자 메모
  createdAt           DateTime @default(now()) @map("created_at")             // 생성 시간
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")  // 수정 시간

  @@map("fee_configurations")
}

model MembershipGrade {
  id            Int      @id @default(autoincrement())                  // 데이터베이스 내부 관리용 고유 ID (자동 증가)
  name          String   @unique                                        // 등급 이름 (예: "NEW", "SILVER", "GOLD", "DIAMOND")
  discountRate  Float    @default(0) @map("discount_rate")               // 국제 배송비 할인율 (0~1 사이 소수, 예: 0.1 = 10%)
  requiredOrders Int     @default(0) @map("required_orders")             // guide/membership에 표시되는 "주문 N건" 등업 기준 주문 건수
  sortOrder     Int      @default(0) @map("sort_order")                  // 낮은 등급 → 높은 등급 순으로 정렬하기 위한 순서값
  description   String?  @db.Text                                       // 관리자 메모
  createdAt     DateTime @default(now()) @map("created_at")             // 생성 시간
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")  // 수정 시간

  users         User[]                                                 // 이 등급을 가진 회원들 (users.membership_grade FK 역참조)

  @@map("membership_grades")
}

// 🌟 guide/shipping-fee의 "항공" 배송비 계산식(calculateAirShippingFee)에 쓰이는
// 등급별 변수입니다. steps=1(0.5kg 이하)이면 firstStepFee 고정, steps=2 이상이면
// baseFeeAtStepTwo + (steps-2) * stepIncrement 로 계산합니다. DIAMOND는 자체 공식이
// 없고 GOLD 요금에서 discountVsGold*를 빼는 방식이라 baseFeeAtStepTwo/stepIncrement가
// null입니다 (steps<=9: Low, steps=10: Mid, steps>10: High 할인액 적용).
model AirShippingFeeRule {
  id                 Int      @id @default(autoincrement())
  grade              String   @unique                                          // NEW / SILVER / GOLD / DIAMOND
  firstStepFee       Int?     @map("first_step_fee")                           // steps=1(0.5kg 이하)일 때 고정 요금
  baseFeeAtStepTwo   Int?     @map("base_fee_at_step_two")                     // steps=2(1.0kg)일 때 기준 요금 (DIAMOND는 null)
  stepIncrement      Int?     @map("step_increment")                          // steps 3 이상부터 0.5kg(1스텝)마다 추가되는 요금 (DIAMOND는 null)
  discountVsGoldLow  Int?     @map("discount_vs_gold_low")                    // DIAMOND 전용: steps<=9일 때 GOLD 요금에서 빼는 금액
  discountVsGoldMid  Int?     @map("discount_vs_gold_mid")                    // DIAMOND 전용: steps===10일 때 GOLD 요금에서 빼는 금액
  discountVsGoldHigh Int?     @map("discount_vs_gold_high")                   // DIAMOND 전용: steps>10일 때 GOLD 요금에서 빼는 금액
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("air_shipping_fee_rules")
}

// 🌟 guide/shipping-fee의 "EMS" 배송비(calculateEMSShippingFee)는 등급과 무관하며,
// 0.5~7.0kg 구간은 값이 불규칙해 공식화할 수 없어 구간별 실제 요금을 그대로 저장합니다.
// 7kg 초과분은 ShippingFeeExtraRate(method="EMS")를 따릅니다.
model EmsShippingFeeBreakpoint {
  id        Int      @id @default(autoincrement())
  weightKg  Float    @unique @map("weight_kg")                                 // 0.5 ~ 7.0kg (0.5kg 단위)
  fee       Int                                                                // 해당 무게 구간 요금
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("ems_shipping_fee_breakpoints")
}

// 🌟 EMS(7kg 초과)/우체국해운(calculateOceanShippingFee, 1kg 초과) 공통으로 쓰이는
// "기준 무게까지는 고정 요금, 초과분은 1kg당 정액 추가" 규칙입니다.
model ShippingFeeExtraRate {
  id                  Int      @id @default(autoincrement())
  method              String   @unique                                         // "EMS" | "OCEAN"
  thresholdWeightKg   Float    @map("threshold_weight_kg")                    // 이 무게까지는 baseFeeAtThreshold 고정 (EMS=7.0, OCEAN=1.0)
  baseFeeAtThreshold  Int      @map("base_fee_at_threshold")                  // 기준 무게 이하일 때 요금 (EMS=8200, OCEAN=2100)
  extraPerKg          Int      @map("extra_per_kg")                          // 기준 무게 초과 시 1kg마다 추가되는 요금 (EMS=800, OCEAN=400)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("shipping_fee_extra_rates")
}

// 🌟 src/utils/feeCalculator.ts의 calculateTieredPaymentFee/calculateTieredAgencyFee가
// 참조하는 구간 변수입니다. PAYMENT: thresholdValue(엔) 미만이면 belowThresholdFee,
// 이상이면 atOrAboveThresholdAmount(고정 금액). AGENCY: thresholdValue(개) 미만이면
// belowThresholdFee(고정 금액), 이상이면 수량 × atOrAboveThresholdAmount(수량당 단가).
// 어느 쪽으로 해석할지는 feeType에 따라 코드(feeCalculator.ts)에서 결정합니다.
model OrderFeeRule {
  id                        Int      @id @default(autoincrement())
  feeType                   String   @unique @map("fee_type")                       // "PAYMENT" | "AGENCY"
  thresholdValue            Float    @map("threshold_value")                        // PAYMENT: 상품금액 기준(엔), AGENCY: 수량 기준(개)
  belowThresholdFee         Int      @map("below_threshold_fee")                    // 기준 미만일 때 금액(엔)
  atOrAboveThresholdAmount  Int      @map("at_or_above_threshold_amount")           // 기준 이상일 때 금액(엔) — PAYMENT는 고정값, AGENCY는 수량당 단가
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("order_fee_rules")
}

model MercariCategory {
  id          Int      @id @default(autoincrement())  // 메루카리 고유 ID
  genreId     Int      @unique                        // 메루카리 카테고리 ID
  genreName   String                                  // 카테고리 이름
  genreLevel  Int?     @default(1)                    // 1:대분류, 2:중분류, 3:소분류...
  parentId    Int                                     // 부모 카테고리 ID
  isLeaf      Boolean  @default(false)                // 💡 최하위 카테고리 여부 저장 (기본값 false)
  updatedAt   DateTime @updatedAt                     // 데이터 갱신일 (자동)

  @@map("MercariCategory")
}

model RakutenCategory {
  id          Int      @id @default(autoincrement())  // 메루카리 고유 ID
  genreId     Int      @unique                        // 메루카리 카테고리 ID
  genreName   String                                  // 카테고리 이름
  genreLevel  Int?     @default(1)                    // 1:대분류, 2:중분류, 3:소분류...
  parentId    Int                                     // 부모 카테고리 ID
  isLeaf      Boolean  @default(false)                // 💡 최하위 카테고리 여부 저장 (기본값 false)
  updatedAt   DateTime @updatedAt                     // 데이터 갱신일 (자동)

  @@map("RakutenCategory")
}

model YahooAuctionCategory {
  id         Int      @id @default(autoincrement())
  genreId    Int      @unique
  listId     Int?     @default(0) 
  genreName  String
  genreLevel Int?     @default(1) 
  parentId   Int
  isLeaf     Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@map("YahooAuctionCategory")
}

model YahooShoppingCategory {
  id         Int      @id @default(autoincrement())
  genreId    Int      @unique
  genreName  String
  genreLevel Int?     @default(1) 
  parentId   Int
  isLeaf     Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@map("YahooShoppingCategory")
}

model AmazonCategory {
  id         Int      @id @default(autoincrement())
  genreId    Int      @unique
  genreName  String
  genreLevel Int?     @default(1) 
  parentId   Int
  isLeaf     Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@map("AmazonCategory")
}


// 2. 머니 로그 타입 Enum 추가
enum MoneyLogType {
  CHARGE  // 충전
  USE     // 사용
  REFUND  // 환불
}

// 3. 🆕 머니 로그 모델 추가
model MoneyLog {
  id            Int           @id @default(autoincrement())
  userId        Int           @map("user_id")
  user          User          @relation(fields: [userId], references: [id])
  
  // 구분: 충전, 사용, 환불
  type          MoneyLogType
  
  // 상세 내용: "무통장 입금 충전", "주문 결제(주문번호: ...)" 등
  content       String        @db.Text
  
  // 금액: 발생한 금액 (예: 50000 또는 -35000)
  amount        Int
  
  // 잔액: 거래 직후의 최종 잔액 (이미지의 마지막 컬럼용)
  balanceAfter  Int           @map("balance_after")
  
  // 일시: 거래 발생 시간
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("money_logs")
  @@index([userId]) // 사용자별 내역 조회를 위한 인덱스
}

enum RequestType {
  CHARGE
  REFUND
}

enum RequestStatus {
  PENDING   // 대기
  APPROVED  // 승인됨
  REJECTED  // 반려됨
}

model MoneyRequest {
  id            Int           @id @default(autoincrement())
  userId        Int
  type          RequestType   // CHARGE, REFUND
  status        RequestStatus @default(PENDING)
  amount        Int
  
  // 🏦 환불 관련 상세 정보 (환불일 때만 입력됨)
  bankName      String?       // 은행명
  accountNumber String?       // 계좌번호
  accountHolder String?       // 예금주
  
  content       String?       // 추가 메모 (충전 시 입금자명 등)
  adminNote     String?       // 반려 사유 등
  createdAt     DateTime      @default(now())
  processedAt   DateTime?

  user          User          @relation(fields: [userId], references: [id])
}

// 🌟 api/estimate의 견적 계산 시 사용하는 환율 관련 설정값 (관리자가 수정하는 단일 설정 레코드)
model ExchangeRateConfig {
  id                  Int      @id @default(autoincrement())
  additionalRate      Float    @default(0)   @map("additional_rate")       // 추가 증가액
  rateBasisUnit       Int      @default(100) @map("rate_basis_unit")       // 몇 엔 기준으로 다시 계산해서 보여줄지의 기준값
  currentExchangeRate Float    @default(0)   @map("current_exchange_rate") // 현재 환율
  updatedAt           DateTime? @map("updated_at")                        // 마지막 업데이트 시간 (null 허용)

  @@map("exchange_rate_configs")
}

model Translation {
  id        Int      @id @default(autoincrement())
  jp        String   @unique // 일본어 원문 (중복 저장 방지 및 빠른 검색)
  ko        String   // 번역된 한국어
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jp]) // 검색 성능을 위한 인덱스 추가
}

// 🌟 상품 상세 정보를 열람할 때마다 조회수를 누적해, "실시간 인기 상품" 랜딩 섹션에 활용합니다.
// platform 필드를 넣어둬서 나중에 mercari/yahoo_shopping 등 다른 쇼핑몰로도 확장할 수 있게 했습니다.
model ProductPopularity {
  id           Int      @id @default(autoincrement())
  platform     String                        // 'rakuten' | 'mercari' | ...
  itemId       String                        // 플랫폼별 상품 고유 ID (예: 라쿠텐 itemCode)
  name         String   @db.Text             // 최근 조회 시점의 상품명 (표시용 캐시)
  price        Int      @default(0)
  thumbnail    String?  @db.Text
  url          String   @db.Text
  shopName     String?
  viewCount    Int      @default(1)
  lastViewedAt DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([platform, itemId])
  @@index([platform, viewCount])
  @@map("ProductPopularity")
}

// 🌟 카테고리를 클릭할 때마다 조회수를 누적해, 야후 옥션처럼 "메인 화면에 뜰 만한 상품"이
// 없는 플랫폼에서 실시간 인기 상품 소스 카테고리를 실제 사용자 행동 기반으로 고를 때 씁니다.
model CategoryPopularity {
  id            Int      @id @default(autoincrement())
  platform      String                        // 'yahoo_auction' | ...
  genreId       Int                           // 플랫폼별 카테고리 고유 ID
  genreName     String?                       // 최근 클릭 시점의 카테고리 이름 (표시/디버깅용 캐시)
  clickCount    Int      @default(1)
  lastClickedAt DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([platform, genreId])
  @@index([platform, clickCount])
  @@map("CategoryPopularity")
}